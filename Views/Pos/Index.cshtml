@model DashboardViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Punto de venta";
    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
}
<div class="app-shell">
    <aside class="sidebar">
        <div class="brand"><span class="brand-mark">A</span><span><b>ATLAS</b><small>punto de venta</small></span></div>
        <nav>
            <button class="nav-item active" data-view="sale"><span>▦</span> Venta</button>
            <button class="nav-item" data-view="inventory"><span>▣</span> Inventario <i>@Model.LowStockCount</i></button>
            <button class="nav-item" data-view="manufacturing"><span>⚙</span> Fabricación</button>
            <button class="nav-item" data-view="customers"><span>♙</span> Clientes</button>
            <button class="nav-item" data-view="purchases"><span>⇩</span> Compras</button>
            <button class="nav-item" data-view="returns"><span>↩</span> Devoluciones</button>
            <button class="nav-item" data-view="cash"><span>◫</span> Caja</button>
            <button class="nav-item" data-view="reports"><span>↗</span> Reportes</button>
            <button class="nav-item" data-view="devices"><span>⌁</span> Dispositivos</button>
            @if(User.IsInRole("Administrator")){<button class="nav-item" data-view="users"><span>♟</span> Usuarios</button><button class="nav-item" data-view="audit"><span>◉</span> Auditoría</button>}
        </nav>
        <div class="sidebar-bottom">
            <div class="store"><span class="online-dot"></span><div><b>Sucursal Centro</b><small>Caja 01 · En línea</small></div></div>
            <form asp-controller="Auth" asp-action="Logout" method="post"><button class="user-card" title="Cerrar sesión"><span>@(User.Identity?.Name?[..Math.Min(2,User.Identity.Name.Length)].ToUpperInvariant() ?? "AD")</span><div><b>@(User.Identity?.Name ?? "Administrador")</b><small>@(User.IsInRole("Administrator") ? "Administrador" : "Operador") · Salir</small></div><i>↪</i></button></form>
        </div>
    </aside>

    <main class="workspace">
        <header class="topbar">
            <button class="mobile-menu" id="mobileMenu">☰</button>
            <div><h1 id="viewTitle">Nueva venta</h1><p id="clock"></p></div>
            <div class="top-actions"><button class="shortcut" id="newSale">Nueva venta <kbd>F2</kbd></button><button class="icon-btn" title="Ayuda">?</button></div>
        </header>

        <section class="view active" id="view-sale">
            <div class="sale-grid">
                <section class="catalog-panel">
                    <div class="search-wrap"><span>⌕</span><input id="productSearch" autocomplete="off" placeholder="Escanea o busca por producto, SKU o código..." autofocus/><kbd>F3</kbd></div>
                    <div class="category-row" id="categories"><button class="chip active" data-category="Todos">Todos</button></div>
                    <div class="products" id="products"></div>
                </section>
                <aside class="cart-panel">
                    <div class="cart-head"><div><h2>Ticket actual</h2><span id="folioDraft">Venta sin guardar</span></div><button id="clearCart" class="link-danger">Limpiar</button></div>
                    <button class="customer-select" id="customerButton"><span>♙</span><div><small>CLIENTE</small><b id="customerName">Público general</b></div><i>›</i></button>
                    <div class="cart-lines" id="cartLines"><div class="empty-cart"><div>⌑</div><h3>Tu ticket está vacío</h3><p>Escanea un código o selecciona un producto para comenzar.</p></div></div>
                    <div class="cart-summary">
                        <div><span>Subtotal</span><b id="subtotal">$0.00</b></div>
                        <button class="discount-row" id="discountButton"><span>Descuento</span><b id="discount">Agregar</b></button>
                        <div><span>Impuestos</span><b id="tax">$0.00</b></div>
                        <div class="grand-total"><span>Total</span><b id="total">$0.00</b></div>
                        <button class="pay-button" id="payButton" disabled><span>Cobrar</span><b id="payTotal">$0.00</b><kbd>F4</kbd></button>
                    </div>
                </aside>
            </div>
        </section>

        <section class="view content-view" id="view-inventory"><div class="section-heading"><div><h2>Inventario</h2><p>Existencias actualizadas con cada venta.</p></div><button class="primary-small" id="newProduct">+ Nuevo producto</button></div><div class="data-card"><table><thead><tr><th>Producto</th><th>SKU</th><th>Categoría</th><th>Precio</th><th>Existencia</th><th>Estado</th></tr></thead><tbody id="inventoryTable"></tbody></table></div></section>
        <section class="view content-view" id="view-customers"><div class="section-heading"><div><h2>Dashboard de clientes</h2><p>Calidad del directorio y preparación fiscal desde MySQL.</p></div><div class="heading-actions"><a class="secondary-small" href="/Pos/CustomerDashboardPdf">Descargar PDF</a><button class="primary-small" id="newCustomer">+ Nuevo cliente</button></div></div><div class="metric-grid customer-metrics"><article><small>CLIENTES</small><h2>@Model.CustomerDashboard.Total</h2><span>Registros activos</span></article><article><small>CON RFC</small><h2>@Model.CustomerDashboard.WithRfc</h2><span>Identificación fiscal</span></article><article><small>CON CORREO</small><h2>@Model.CustomerDashboard.WithEmail</h2><span>Contacto digital</span></article><article><small>LISTOS PARA CFDI</small><h2>@Model.CustomerDashboard.FiscalReady</h2><span>Expediente completo</span></article></div><div class="data-card segment-card"><div class="card-title"><h3>Completitud del directorio</h3></div>@foreach(var segment in Model.CustomerDashboard.Segments){<div class="segment-row"><span>@segment.Name <b>@segment.Count</b></span><div><i style="width:@segment.Percentage.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></i></div><strong>@segment.Percentage.ToString("0.0")%</strong></div>}</div><div class="customer-toolbar"><label for="customerSearch">Buscar cliente</label><input id="customerSearch" type="search" placeholder="Nombre, RFC, correo o teléfono" autocomplete="off" /></div><div class="customer-grid" id="customerGrid"></div></section>
        <section class="view content-view" id="view-purchases"><div class="section-heading"><div><h2>Compras y proveedores</h2><p>Recibe mercancía y actualiza costo y existencia.</p></div><button class="primary-small" id="newPurchase">+ Recibir compra</button></div><div class="data-card"><table><thead><tr><th>Folio</th><th>Proveedor</th><th>Fecha</th><th>Total</th><th>Estado</th></tr></thead><tbody id="purchasesTable"></tbody></table></div></section>
        <section class="view content-view" id="view-manufacturing"><div class="section-heading"><div><h2>Fabricación</h2><p>Convierte materias primas en productos terminados y actualiza inventario.</p></div><button class="primary-small" id="newRecipe">+ Nueva receta</button></div><div class="data-card"><table><thead><tr><th>Producto terminado</th><th>Rendimiento</th><th>Componentes</th><th></th></tr></thead><tbody id="recipeTable"></tbody></table></div></section>
        <section class="view content-view" id="view-returns"><div class="empty-feature compact-feature"><span>↩</span><h2>Devolver una venta</h2><p>Repone existencias y registra el reembolso pendiente.</p><div class="return-form"><input id="returnFolio" placeholder="Folio de venta"/><textarea id="returnReason" placeholder="Motivo de la devolución"></textarea><button class="primary-small" id="processReturn">Procesar devolución total</button></div></div></section>
        <section class="view content-view" id="view-cash"><div class="metric-grid"><article><small>VENTAS DE HOY</small><h2 id="todaySales">@Model.TodaySales.ToString("C")</h2><span class="positive">Turno actual</span></article><article><small>TICKETS</small><h2 id="todayTickets">@Model.TodayTickets</h2><span>Operaciones completadas</span></article><article><small>CAJA</small><h2 id="shiftStatus">Abierta</h2><span class="positive" id="shiftDetail">Consultando...</span></article></div><div class="section-heading"><div><h2>Corte de caja</h2><p>Compara el efectivo esperado contra el contado.</p></div><button class="primary-small" id="closeShift">Realizar corte</button></div><div class="data-card"><div class="card-title"><h3>Ventas recientes</h3></div><div id="recentSales"></div></div></section>
        <section class="view content-view" id="view-reports"><div class="section-heading"><div><h2>Reporte del día</h2><p>Resumen calculado desde MySQL.</p></div><button class="primary-small" id="exportReport">Exportar CSV</button></div><div class="metric-grid"><article><small>VENTA NETA</small><h2>@Model.TodaySales.ToString("C")</h2><span>Ventas completadas</span></article><article><small>OPERACIONES</small><h2>@Model.TodayTickets</h2><span>Tickets del día</span></article><article><small>TICKET PROMEDIO</small><h2>@((Model.TodayTickets == 0 ? 0 : Model.TodaySales/Model.TodayTickets).ToString("C"))</h2><span>Promedio por operación</span></article></div><div class="data-card"><table><thead><tr><th>Folio</th><th>Fecha</th><th>Subtotal</th><th>Impuesto</th><th>Total</th></tr></thead><tbody id="reportTable">@foreach(var sale in Model.RecentSales){<tr><td>@sale.Folio</td><td>@sale.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td><td>@sale.Subtotal.ToString("C")</td><td>@sale.Tax.ToString("C")</td><td><b>@sale.Total.ToString("C")</b></td></tr>}</tbody></table></div></section>
        <section class="view content-view" id="view-devices"><div class="section-heading"><div><h2>Centro de conexiones</h2><p>Captura datos, guarda y prueba. No necesitas editar archivos ni código.</p></div></div><div class="connection-guide"><b>Flujo:</b><span>1. Configurar</span><span>2. Guardar cifrado</span><span>3. Probar conexión</span><span>4. Instalar SDK sólo cuando el protocolo sea propietario</span></div><div class="device-grid" id="deviceGrid"></div></section>
        <section class="view content-view" id="view-audit"><div class="section-heading"><div><h2>Auditoría</h2><p>Trazabilidad administrativa.</p></div><div><a class="primary-small button-link" href="/Operations/Backup">Descargar respaldo</a> <button class="primary-small" id="refreshAudit">Actualizar</button></div></div><div class="data-card"><table><thead><tr><th>Fecha</th><th>Usuario</th><th>Acción</th><th>Entidad</th><th>Referencia</th></tr></thead><tbody id="auditTable"></tbody></table></div></section>
        <section class="view content-view" id="view-users"><div class="section-heading"><div><h2>Usuarios y permisos</h2><p>Administradores, encargados y cajeros.</p></div><button class="primary-small" id="newUser">+ Nuevo usuario</button></div><div class="data-card"><table><thead><tr><th>Nombre</th><th>Correo</th><th>Rol</th><th>Estado</th><th></th></tr></thead><tbody id="usersTable"></tbody></table></div></section>
    </main>
</div>

<div class="modal-backdrop" id="modalBackdrop">
    <div class="modal" id="paymentModal">
        <button class="modal-close" data-close>×</button><div class="modal-step" id="paymentStep"><span class="eyebrow">FINALIZAR VENTA</span><h2>¿Cómo pagará el cliente?</h2><div class="amount-due"><span>Total a cobrar</span><b id="modalTotal">$0.00</b></div><div class="payment-methods"><button data-method="cash"><span>＄</span><b>Efectivo</b><small>Cambio automático</small></button><button data-method="card"><span>▣</span><b>Tarjeta</b><small>Crédito o débito</small></button><button data-method="transfer"><span>⇄</span><b>Transferencia</b><small>Con referencia</small></button></div><label>Monto recibido<input type="number" id="paymentAmount" min="0" step="0.01" /></label><div class="change-preview"><span>Cambio</span><b id="changeAmount">$0.00</b></div><button class="confirm-button" id="confirmPayment">Confirmar cobro</button></div>
        <div class="modal-step success-step" id="successStep"><div class="success-icon">✓</div><h2>¡Venta completada!</h2><p id="successFolio"></p><div class="success-total" id="successTotal"></div><div class="success-actions"><button id="printTicket">Imprimir ticket</button><button id="invoiceSale">Facturar</button></div><button class="confirm-button" id="finishSale">Nueva venta</button></div>
    </div>
    <div class="modal small-modal" id="customerModal"><button class="modal-close" data-close>×</button><span class="eyebrow">ASIGNAR CLIENTE</span><h2>Selecciona un cliente</h2><div id="customerOptions"></div></div>
    <div class="modal small-modal" id="discountModal"><button class="modal-close" data-close>×</button><span class="eyebrow">DESCUENTO</span><h2>Aplicar al ticket</h2><label>Porcentaje<input id="discountInput" type="number" min="0" max="100" value="0" /></label><button class="confirm-button" id="applyDiscount">Aplicar descuento</button></div>
    <div class="modal small-modal" id="productModal"><button class="modal-close" data-close>×</button><span class="eyebrow">INVENTARIO</span><h2>Nuevo producto</h2><div class="form-grid"><label>Nombre<input id="pName" maxlength="180" /></label><label>SKU<input id="pSku" maxlength="60" /></label><label>Código de barras<input id="pBarcode" maxlength="80" /></label><label>Categoría<input id="pCategory" value="General" /></label><label>Precio<input id="pPrice" type="number" min="0" step=".01" /></label><label>Costo<input id="pCost" type="number" min="0" step=".01" /></label><label>Existencia<input id="pStock" type="number" min="0" step=".001" /></label><label>IVA<select id="pTax"><option value="0">0%</option><option value=".08">8%</option><option value=".16">16%</option></select></label></div><label class="check-label"><input id="pWeighted" type="checkbox" /> Producto pesable por kilogramo</label><button class="confirm-button" id="saveProduct">Guardar producto</button></div>
    <div class="modal small-modal" id="newCustomerModal"><button class="modal-close" data-close>×</button><span class="eyebrow">CLIENTES</span><h2>Nuevo cliente</h2><div class="form-grid"><label>Nombre<input id="cName" maxlength="180" required /></label><label>RFC<input id="cRfc" maxlength="13" pattern="([A-Za-zÑñ&]{3,4}[0-9]{6}[A-Za-z0-9]{3})?" autocapitalize="characters" /></label><label>Correo<input id="cEmail" type="email" maxlength="254" /></label><label>Teléfono<input id="cPhone" maxlength="30" inputmode="tel" /></label><label>Razón social<input id="cLegal" maxlength="180" /></label><label>Régimen fiscal<input id="cRegime" maxlength="3" pattern="[0-9]{3}" inputmode="numeric" /></label><label>Código postal fiscal<input id="cZip" maxlength="5" pattern="[0-9]{5}" inputmode="numeric" /></label><label>Uso CFDI<input id="cUse" maxlength="4" pattern="[A-Za-z0-9]{3,4}" autocapitalize="characters" /></label></div><p class="form-help">Los cinco datos fiscales completos habilitan al cliente para facturación CFDI.</p><button class="confirm-button" id="saveCustomer">Guardar cliente</button></div>
    <div class="modal" id="purchaseModal"><button class="modal-close" data-close>×</button><span class="eyebrow">ENTRADA DE INVENTARIO</span><h2>Recibir compra</h2><label>Proveedor<select id="purchaseSupplier"></select></label><label>Referencia / factura<input id="purchaseReference"/></label><div class="purchase-line"><select id="purchaseProduct"></select><input id="purchaseQuantity" type="number" min=".001" step=".001" placeholder="Cantidad"/><input id="purchaseCost" type="number" min="0" step=".01" placeholder="Costo"/><button id="addPurchaseLine">Agregar</button></div><div id="purchaseLines" class="purchase-lines"></div><button class="confirm-button" id="savePurchase">Recibir mercancía</button></div>
    <div class="modal small-modal" id="closeShiftModal"><button class="modal-close" data-close>×</button><span class="eyebrow">CORTE DE CAJA</span><h2>Contar efectivo</h2><div class="amount-due"><span>Efectivo esperado</span><b id="expectedCash">$0.00</b></div><label>Efectivo contado<input id="countedCash" type="number" min="0" step=".01"/></label><div class="change-preview"><span>Diferencia</span><b id="cashDifference">$0.00</b></div><button class="confirm-button" id="confirmCloseShift">Cerrar turno</button></div>
    <div class="modal small-modal" id="userModal"><button class="modal-close" data-close>×</button><span class="eyebrow">SEGURIDAD</span><h2>Nuevo usuario</h2><label>Nombre<input id="uName"/></label><label>Correo<input id="uEmail" type="email"/></label><label>Contraseña temporal<input id="uPassword" type="password" minlength="10"/></label><label>Rol<select id="uRole"><option value="Cashier">Cajero</option><option value="Manager">Encargado</option><option value="Administrator">Administrador</option></select></label><button class="confirm-button" id="saveUser">Crear usuario</button></div>
    <div class="modal" id="peripheralModal"><button class="modal-close" data-close>×</button><span class="eyebrow">CONEXIONES DE ESTA CAJA</span><h2 id="peripheralTitle">Configurar dispositivo</h2><input type="hidden" id="dKey"/><div class="form-grid"><label>Proveedor o marca<input id="dProvider" maxlength="120" placeholder="Ej. Epson, Torrey, Clip, Facturama" required/></label><label>Tipo de conexión<select id="dConnection"><option value="Agent">Atlas Agent instalado en esta caja</option><option value="HID">HID / teclado del navegador</option><option value="Windows">Impresora instalada en el servidor</option><option value="TCP">TCP / red</option><option value="HTTP">HTTP / API</option><option value="Serial">Serial conectado al servidor</option><option value="Canvas">Canvas local</option><option value="PAC">PAC / API CFDI</option></select></label><label>Host, IP o URL<input id="dEndpoint" maxlength="500" placeholder="Agente: http://IP-DE-CAJA:17420"/></label><label>Puerto<input id="dPort" type="number" min="1" max="65535" placeholder="9100"/></label><label>Puerto o identificador<input id="dDeviceId" maxlength="160" placeholder="COM3 o nombre exacto de impresora Windows"/></label><label>Modo<input id="dMode" maxlength="60" placeholder="continuous, command=P, Windows ESC/POS o ZPL"/></label></div><label>Token del agente, API key o secreto<input id="dSecret" type="password" maxlength="500" autocomplete="new-password" placeholder="Vacío conserva el secreto guardado"/></label><label class="check-label"><input id="dEnabled" type="checkbox" checked/> Habilitar esta integración</label><div class="connection-result" id="connectionResult">Esta configuración pertenece únicamente a la caja actual.</div><div class="modal-actions"><button class="secondary-small" id="testPeripheral">Probar conexión / imprimir</button><button class="confirm-button" id="savePeripheral">Guardar configuración</button></div></div>
    <div class="modal" id="recipeModal"><button class="modal-close" data-close>×</button><span class="eyebrow">FABRICACIÓN</span><h2>Nueva receta</h2><div class="form-grid"><label>Producto terminado<select id="recipeProduct"></select></label><label>Rendimiento por lote<input id="recipeOutput" type="number" min=".001" step=".001" value="1"/></label></div><div class="purchase-line"><select id="componentProduct"></select><input id="componentQuantity" type="number" min=".001" step=".001" placeholder="Cantidad por lote"/><button id="addComponent">Agregar</button></div><div id="recipeComponents" class="purchase-lines"></div><button class="confirm-button" id="saveRecipe">Guardar receta</button></div>
    <div class="modal small-modal" id="produceModal"><button class="modal-close" data-close>×</button><span class="eyebrow">ORDEN DE PRODUCCIÓN</span><h2 id="produceTitle">Fabricar</h2><input id="produceRecipeId" type="hidden"/><label>Número de lotes<input id="produceBatches" type="number" min=".001" step=".001" value="1"/></label><div class="connection-result">Al confirmar se descontarán materias primas y se ingresará el producto terminado en una sola transacción.</div><button class="confirm-button" id="confirmProduce">Confirmar fabricación</button></div>
</div>
<div class="toast" id="toast"></div>
<form id="antiForgeryForm">@Html.AntiForgeryToken()</form>
<script>
window.atlasData = @Html.Raw(JsonSerializer.Serialize(new { products = Model.Products, customers = Model.Customers, recentSales = Model.RecentSales, canOpenDrawer = User.IsInRole("Administrator") || User.IsInRole("Manager"), serverContext = (bool?)ViewData["ServerContext"] == true }, jsonOptions));
</script>
