    <Compile Include="..\Integrations\SerialScaleRuntime.cs" Link="Integrations\SerialScaleRuntime.cs" />
    <Compile Include="..\Integrations\IntegrationContracts.cs" Link="Integrations\IntegrationContracts.cs" />
    <Compile Include="..\Integrations\PublicProtocolAdapters.cs" Link="Integrations\PublicProtocolAdapters.cs" />
    <Compile Include="..\Integrations\WindowsRawPrinter.cs" Link="Integrations\WindowsRawPrinter.cs" />
    <Content Update="atlasagentsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
